# ===========================================================================
# Atlas RAG - environment configuration
# Copy to .env and fill in.  `cp .env.example .env`
# ===========================================================================

# --- LLM: Ollama Cloud, a local daemon, or offline ---------------------------
# Three supported configurations:
#
#   1. Ollama Cloud   BASE_URL=https://ollama.com  + an API key
#                     Key: https://ollama.com/settings/keys  (free, rate-limited)
#   2. Local daemon   BASE_URL=http://localhost:11434  and NO key
#                     Any non-ollama.com host counts as local - a LAN address or
#                     a Docker bridge IP such as http://172.18.1.122:11434 works.
#   3. Offline demo   BASE_URL=https://ollama.com and NO key
#                     Extractive answers with real citations, zero network.
#
# Offline mode is chosen ONLY in case 3: pointed at the hosted service with no
# key. A local daemon needs no key and is used as-is.
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_CHAT_MODEL=gpt-oss:120b
OLLAMA_FAST_MODEL=gpt-oss:20b
OLLAMA_REQUEST_TIMEOUT=180

# --- Embeddings -------------------------------------------------------------
# provider: huggingface | ollama
# huggingface -> runs locally, no API quota used, 384-dim BAAI/bge-small-en-v1.5
# ollama      -> requires a LOCAL ollama daemon with `ollama pull nomic-embed-text`
EMBED_PROVIDER=huggingface
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384
OLLAMA_EMBED_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Vector store -----------------------------------------------------------
# backend: qdrant | chroma
VECTOR_BACKEND=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=atlas_docs
CHROMA_PATH=./storage/chroma

# --- Retrieval tuning -------------------------------------------------------
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=8
FUSION_TOP_K=20

# --- Generation budget (lower these if a local CPU model is slow) -----------
# Prompt size is what makes local inference slow: the model must process every
# context token before writing the first word. On a CPU-only machine, 5 chunks
# and 6000 chars is roughly 3x faster to first token than the defaults.
MAX_CONTEXT_CHUNKS=16      # caps each use case's own top_k
MAX_CONTEXT_CHARS=14000    # hard ceiling on the context block
ANSWER_MAX_TOKENS=1600     # longest answer the model may write
RELEVANCE_THRESHOLD=0.35
MAX_REFINE_LOOPS=2

# --- Document parsing -------------------------------------------------------
# parser: docling | mineru | simple
PARSER=docling
DOCLING_DO_OCR=false
DOCLING_DO_TABLE_STRUCTURE=true

# --- Authentication ---------------------------------------------------------
# Signs session cookies. Generated into storage/.session_secret on first run if
# unset, which is fine on one machine - but SET IT in production so sessions
# survive a restart and are shared across replicas.
ATLAS_SECRET_KEY=

# Required to self-register an administrator through the signup form.
# Generated into storage/.admin_signup_code if unset. Without this gate anyone
# visiting the deployment could tick "Administrator" and read every department,
# which would make the access control decorative.
ATLAS_ADMIN_SIGNUP_CODE=

# --- API / app --------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
CORS_ORIGINS=*
LOG_LEVEL=INFO

# Shows the evidence rail (retrieved chunks and relevance scores), the agent
# trace and the graph view in the console. Off for everyone by default,
# administrators included - these are instruments for whoever builds and runs
# the retriever, not a privilege any account inside the product can hold.
# Turn it on locally when you need to see why a query retrieved what it did.
# Readers are not left in the dark either way: asking "where is this
# documented?" names the document, section and page in the reply.
DEVELOPER_MODE=false
